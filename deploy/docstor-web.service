[Unit]
Description=docstor web (docsify 镜像站 + 问题 API)
After=network.target

# 安装：cp deploy/docstor-web.service /etc/systemd/system/ && systemctl daemon-reload
#       systemctl enable --now docstor-web.service
# 改完代码不用重启：systemctl reload docstor-web.service（HUP 滚动重载，实测零 502）
[Service]
Type=simple
WorkingDirectory=/opt/projects/docstor
# 4 个 worker × 4 线程（16 核实测：单进程峰值 30 请求/秒，4 进程 61 请求/秒）
# 不要加 --preload：app.py 导入时就建了 SQLite 连接，fork 后共享会出问题
ExecStart=/usr/local/bin/gunicorn -w 4 --threads 4 \
          -b 127.0.0.1:3009 \
          --timeout 180 --graceful-timeout 30 --keep-alive 5 \
          --access-logfile - --access-logformat '%(h)s %(t)s "%(r)s" %(s)s %(b)s %(D)sus' \
          wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=always
RestartSec=3
StandardOutput=append:/opt/projects/docstor/logs/web.log
StandardError=append:/opt/projects/docstor/logs/web.log

[Install]
WantedBy=multi-user.target
